@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<EcommerceApp.Models.Category>;
    var banners = ViewBag.Banners as List<EcommerceApp.Models.Banner>;
    var bestSellers = ViewBag.BestSellers as List<EcommerceApp.Models.Product> ?? new List<EcommerceApp.Models.Product>();
    string[] catIcons = { "bi-headphones", "bi-bag", "bi-house-door", "bi-droplet-half", "bi-bicycle", "bi-controller", "bi-book", "bi-three-dots" };
}

<!-- Hero: banners OR default lavender block -->
@if (banners != null && banners.Any())
{
    <div id="homeBannerCarousel" class="carousel slide shopper-banner-carousel mb-4 mb-lg-5" data-bs-ride="carousel">
        <div class="carousel-inner shadow-sm">
            @for (int i = 0; i < banners.Count; i++)
            {
                var banner = banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="position-relative" style="min-height:340px;">
                        @if (!string.IsNullOrEmpty(banner.ImageUrl))
                        {
                            <img src="@banner.ImageUrl" class="w-100" alt="@banner.Title" style="height:340px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="shopper-hero w-100" style="min-height:340px;">
                                <div class="shopper-hero-orb"></div>
                            </div>
                        }
                        <div class="position-absolute bottom-0 start-0 end-0 p-4 p-lg-5 text-white" style="background:linear-gradient(transparent,rgba(26,26,46,.88));">
                            <p class="shopper-kicker text-white mb-2 opacity-75">FEATURED</p>
                            <h2 class="display-6 fw-bold">@banner.Title</h2>
                            @if (!string.IsNullOrEmpty(banner.Subtitle)) { <p class="mb-3 opacity-90">@banner.Subtitle</p> }
                            <a href="@(string.IsNullOrEmpty(banner.LinkUrl) ? Url.Action("Shop", "Home") : banner.LinkUrl)" class="btn shopper-btn-cta rounded-pill">Shop now<i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (banners.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon rounded-circle bg-dark bg-opacity-25"></span></button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next"><span class="carousel-control-next-icon rounded-circle bg-dark bg-opacity-25"></span></button>
        }
    </div>
}
else
{
    <section class="shopper-hero mb-4 mb-lg-5 px-4 px-lg-5 py-5 d-flex align-items-center">
        <div class="shopper-hero-orb"></div>
        <div class="row align-items-center w-100 position-relative z-1 g-4">
            <div class="col-lg-7">
                <p class="shopper-kicker mb-2">SUMMER COLLECTION</p>
                <h1 class="display-5 display-lg-4 mb-3">Upgrade your style this summer</h1>
                <p class="lead text-muted mb-4">Curated essentials, trending categories, and secure checkout — all in one place.</p>
                <a asp-action="Shop" class="btn shopper-btn-cta rounded-pill">Shop now<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <i class="bi bi-bag-heart display-1" style="color:var(--shopper-accent);opacity:.35;"></i>
            </div>
        </div>
    </section>
}

@if (categories != null && categories.Any())
{
    <section class="mb-5" id="categories">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h2 class="shopper-section-title h4 mb-0">Shop by category</h2>
            <a asp-action="Shop" class="small fw-bold text-decoration-none d-none d-sm-inline" style="color:var(--shopper-indigo);">View all →</a>
        </div>
        <div class="shopper-cat-strip pb-1">
            @for (var i = 0; i < categories.Count && i < 12; i++)
            {
                var category = categories[i];
                var icon = catIcons[i % catIcons.Length];
                <a asp-action="Shop" asp-route-categoryId="@category.Id" class="shopper-cat-card">
                    <div class="shopper-cat-icon"><i class="bi @icon"></i></div>
                    <div class="fw-semibold small">@category.Name</div>
                </a>
            }
            <a asp-action="Shop" class="shopper-cat-card">
                <div class="shopper-cat-icon"><i class="bi bi-plus-lg"></i></div>
                <div class="fw-semibold small">More</div>
            </a>
        </div>
    </section>
}

<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="shopper-trust-card h-100">
            <i class="bi bi-truck"></i>
            <h6>Free shipping</h6>
            <p>On qualifying orders nationwide</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="shopper-trust-card h-100">
            <i class="bi bi-arrow-return-left"></i>
            <h6>Easy returns</h6>
            <p>Simple process within policy window</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="shopper-trust-card h-100">
            <i class="bi bi-shield-lock"></i>
            <h6>Secure checkout</h6>
            <p>Encrypted payments powered by Stripe</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="shopper-trust-card h-100">
            <i class="bi bi-headset"></i>
            <h6>24/7 support</h6>
            <p>Reach us anytime via contact form</p>
        </div>
    </div>
</div>

@if (bestSellers.Any())
{
    <section class="shopper-featured-section mb-5" id="best-sellers">
        <div class="shopper-featured-head d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
            <div>
                <h2 class="shopper-section-title h4 mb-1">Best sellers</h2>
                <p class="text-muted small mb-0">Top picks from our catalog</p>
            </div>
            <a asp-action="Shop" class="btn btn-sm btn-shopper-outline">View all</a>
        </div>

        <div class="row g-3 g-lg-4 align-items-stretch">
            <div class="col-12">
                @if (bestSellers.Any())
                {
                    <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-4 h-100">
                        @foreach (var product in bestSellers.Take(8))
                        {
                            <div class="col">
                                <article class="shopper-grid-card h-100">
                                    <div class="shopper-grid-card-media">
                                        <partial name="_ProductCardImage" model='@((product, "shopper-grid-card-link"))' />
                                    </div>
                                    <div class="shopper-grid-card-body">
                                        @if (product.Category != null)
                                        {
                                            <span class="shopper-grid-cat">@product.Category.Name</span>
                                        }
                                        <h4 class="shopper-grid-title">
                                            <a asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">@product.Title</a>
                                        </h4>
                                        <partial name="_ProductPrice" model="product" />
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="shopper-featured-empty h-100 d-flex flex-column align-items-center justify-content-center text-center p-4">
                        <p class="text-muted small mb-2">Mark products as Best Seller in the admin panel to show them here.</p>
                        <a asp-action="Shop" class="btn btn-sm shopper-btn-primary">Open shop</a>
                    </div>
                }
            </div>
        </div>
    </section>
}
else
{
    <section class="text-center py-5 rounded-4" style="background:var(--shopper-lavender);">
        <i class="bi bi-inboxes display-3 text-muted"></i>
        <h3 class="mt-3 fw-bold">No products yet</h3>
        <p class="text-muted">Check back soon — we are adding new arrivals.</p>
        <a asp-action="Shop" class="btn shopper-btn-cta rounded-pill">Browse shop</a>
    </section>
}

@section Scripts {
    <script>
        (function () {
            function scrollToBestSellers() {
                if (window.location.hash !== '#best-sellers') return;
                var el = document.getElementById('best-sellers');
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', scrollToBestSellers);
            } else {
                scrollToBestSellers();
            }
            window.addEventListener('hashchange', scrollToBestSellers);
        })();
    </script>
}

