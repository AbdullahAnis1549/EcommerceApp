@model List<EcommerceApp.Models.Product>

@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var product in Model)
        {
            <div class="col-6 col-md-4 col-xl-3">
                <article class="shopper-product-card d-flex flex-column h-100 position-relative">
                    @if (product.IsDeal && product.HasActiveDiscount)
                    {
                        <span class="position-absolute top-0 start-0 m-2 badge bg-danger z-1">Deal</span>
                    }
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="ratio ratio-1x1 bg-light overflow-hidden">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Title" class="thumb" />
                        }
                        else { <span class="d-flex align-items-center justify-content-center fs-1 text-muted">🖼</span> }
                    </a>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        @if (product.Category != null)
                        {
                            <span class="shopper-chip align-self-start mb-2">@product.Category.Name</span>
                        }
                        <h3 class="h6 fw-bold mb-2"><a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">@product.Title</a></h3>
                        <partial name="_ProductPrice" model="product" />
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-2">View product</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 rounded-4 border" style="background:var(--shopper-surface);">
        <i class="bi bi-inboxes display-4 text-muted"></i>
        <h3 class="fw-bold mt-3">No products here yet</h3>
        <p class="text-muted">@ViewBag.EmptyMessage</p>
        <a asp-controller="Home" asp-action="Shop" class="btn shopper-btn-primary rounded-pill">Browse all products</a>
    </div>
}
