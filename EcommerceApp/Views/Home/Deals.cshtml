@model List<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Deals";
    ViewBag.EmptyMessage = "No active deals. In admin, edit a product: set Original price higher than Sale price, then check “Show on Deals page”.";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="shopper-section-title h4 mb-1">Deals &amp; discounts</h1>
        <p class="text-muted small mb-0">@Model.Count product@(Model.Count != 1 ? "s" : "") on sale — compare original and discounted prices</p>
    </div>
    <a asp-controller="Home" asp-action="Shop" class="btn btn-sm shopper-btn-outline rounded-pill px-3"><i class="bi bi-grid me-1"></i>All products</a>
</div>

<partial name="_ProductListing" model="Model" />
