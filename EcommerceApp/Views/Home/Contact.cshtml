@{ ViewData["Title"] = "Contact Us"; }
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-4">📞 Contact Us</h2>
            @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
            @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
            <form method="post" class="card border-0 shadow-sm p-4">
                @Html.AntiForgeryToken()
                <div class="mb-3"><label class="form-label">Name</label><input name="name" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Message</label><textarea name="message" class="form-control" rows="5" required></textarea></div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </div>
</div>
