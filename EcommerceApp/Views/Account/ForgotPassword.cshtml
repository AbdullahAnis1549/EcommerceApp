@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-warning text-dark text-center py-4">
                    <h3 class="mb-0 fw-bold">Forgot Password</h3>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-muted mb-4">Enter your email address to receive a password reset code.</p>
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <form asp-action="ForgotPassword" asp-controller="Account" method="post" id="forgotPasswordForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-4 text-start">
                            <label for="email" class="form-label fw-bold">Email Address</label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="name@example.com"
                                   required
                                   data-val="true"
                                   data-val-required="Email is required."
                                   data-val-email="Please enter a valid email address." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="email" data-valmsg-replace="true"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning py-2 fw-bold text-dark">Send Reset Code</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <div class="small">
                        <a asp-action="Login" asp-controller="Account" class="text-decoration-none">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

