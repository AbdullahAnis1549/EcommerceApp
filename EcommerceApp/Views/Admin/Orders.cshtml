@model IEnumerable<EcommerceApp.Models.OrderHeader>
@{
    ViewData["Title"] = "Order History";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📋 @(User.IsInRole("admin") ? "Manage All Orders" : "Your Order History")</h2>
    </div>

    @if (Model.Count() > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4">Order ID</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Name</th>
                            <th class="py-3">Phone</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Total</th>
                            <th class="py-3 text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obj in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-primary">#@obj.Id</td>
                                <td>@obj.OrderDate.ToShortDateString()</td>
                                <td>@obj.Name</td>
                                <td>@obj.PhoneNumber</td>
                                <td>
                                    @if (obj.OrderStatus == EcommerceApp.Models.SD.StatusPending)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">@obj.OrderStatus</span>
                                    }
                                    else if (obj.OrderStatus == EcommerceApp.Models.SD.StatusApproved || obj.OrderStatus == EcommerceApp.Models.SD.StatusInProcess)
                                    {
                                        <span class="badge bg-primary rounded-pill">@obj.OrderStatus</span>
                                    }
                                    else if (obj.OrderStatus == EcommerceApp.Models.SD.StatusShipped)
                                    {
                                        <span class="badge bg-success rounded-pill">@obj.OrderStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">@obj.OrderStatus</span>
                                    }
                                </td>
                                <td class="fw-bold">$@obj.OrderTotal.ToString("N2")</td>
                                <td class="text-end px-4">
                                    <a asp-controller="Order" asp-action="Details" asp-route-orderId="@obj.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div style="font-size: 80px; opacity: 0.5;" class="mb-4">📦</div>
            <h3 class="fw-bold mb-3">No Orders Found</h3>
            <p class="text-muted mb-4">@(User.IsInRole("admin") ? "There are no orders in the system yet." : "You haven't placed any orders yet.")</p>
            @if (!User.IsInRole("admin"))
            {
                <a asp-controller="Home" asp-action="Shop" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">Start Shopping</a>
            }
        </div>
    }
</div>
