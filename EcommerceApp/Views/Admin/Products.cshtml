@model List<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Product List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Product" asp-action="Upsert" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Create New Product
            </a>
        </div>
    </div>
    <br /><br />

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Price</th>
                <th>Category</th>
                <th>Placement</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var obj in Model)
            {
                <tr>
                    <td width="15%">
                        @if (!string.IsNullOrEmpty(obj.ImageUrl))
                        {
                            <img src="@obj.ImageUrl" width="50" height="50" style="object-fit:cover; border-radius:5px;" />
                        }
                        else
                        {
                            <span class="text-muted">No Image</span>
                        }
                    </td>
                    <td width="25%">@obj.Title</td>
                    <td width="18%">
                        $@obj.Price
                        @if (obj.HasActiveDiscount)
                        {
                            <br /><small class="text-muted text-decoration-line-through">$@obj.ListPrice!.Value.ToString("N2")</small>
                            <span class="badge bg-danger ms-1">-@obj.DiscountPercent%</span>
                        }
                    </td>
                    <td width="20%">@obj.Category?.Name</td>
                    <td width="15%" class="small">
                        @if (obj.IsDeal) { <span class="badge bg-danger me-1">Deal</span> }
                        @if (obj.IsNewArrival) { <span class="badge bg-info text-dark me-1">New</span> }
                        @if (obj.IsBestSeller) { <span class="badge bg-success me-1">Best</span> }
                        @if (!obj.IsDeal && !obj.IsNewArrival && !obj.IsBestSeller) { <span class="text-muted">—</span> }
                    </td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Product" asp-action="Upsert" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                                <i class="bi bi-trash-fill"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
