@model List<EcommerceApp.Models.Banner>
@{
    ViewData["Title"] = "Manage Banners";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">🖼️ Manage Banners</h2>
    <a asp-controller="Banner" asp-action="Upsert" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Banner
    </a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Subtitle</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var banner in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(banner.ImageUrl))
                                {
                                    <img src="@banner.ImageUrl" style="width:80px;height:45px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <span class="text-muted small">No Image</span>
                                }
                            </td>
                            <td class="fw-semibold">@banner.Title</td>
                            <td class="text-muted">@banner.Subtitle</td>
                            <td>@banner.DisplayOrder</td>
                            <td>
                                @if (banner.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-controller="Banner" asp-action="Upsert" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-controller="Banner" asp-action="Delete" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-danger ms-1">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Koi banner nahi hai. Pehla banner add karein!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
