@model EcommerceApp.Models.AboutPage
@{
    ViewData["Title"] = "About Page";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">About Page</h3>
            <small class="text-muted">This content appears on the storefront About page (Blog menu link).</small>
        </div>
        <a asp-controller="Home" asp-action="About" target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-box-arrow-up-right"></i> Preview
        </a>
    </div>

    <form method="post" asp-controller="About" asp-action="Edit" enctype="multipart/form-data" class="card border-0 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Subtitle" class="form-label fw-semibold"></label>
                        <input asp-for="Subtitle" class="form-control" placeholder="Short tagline under the title" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Body" class="form-label fw-semibold">Page content</label>
                        <textarea asp-for="Body" class="form-control" rows="12" placeholder="Write your about story here..."></textarea>
                        <span asp-validation-for="Body" class="text-danger small"></span>
                        <div class="form-text">Line breaks are preserved on the live page.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Featured image</label>
                        <input type="file" name="file" class="form-control" accept="image/*" />
                    </div>
                    <button type="submit" class="btn btn-primary px-4">Save About Page</button>
                </div>
                <div class="col-lg-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="About preview" class="img-fluid rounded-3 border" />
                    }
                    else
                    {
                        <div class="rounded-3 border bg-light p-4 text-center text-muted small">
                            Optional image for the About page
                        </div>
                    }
                    @if (Model.UpdatedAt != default)
                    {
                        <p class="small text-muted mt-3 mb-0">Last updated: @Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
