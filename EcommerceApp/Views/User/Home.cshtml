@{
    ViewData["Title"] = "My Account";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">Welcome back, @User.Identity?.Name!</h2>
            <p class="text-muted">Manage your shopping, orders, and profile from here.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-cart3 display-4 text-primary"></i>
                    <h5 class="mt-3">Cart</h5>
                    <p class="display-6 fw-bold mb-3">@ViewBag.CartCount</p>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-primary">View Cart</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-heart display-4 text-danger"></i>
                    <h5 class="mt-3">Wishlist</h5>
                    <p class="display-6 fw-bold mb-3">@ViewBag.WishlistCount</p>
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-outline-danger">View Wishlist</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-bag-check display-4 text-success"></i>
                    <h5 class="mt-3">Orders</h5>
                    <p class="display-6 fw-bold mb-3">@ViewBag.OrderCount</p>
                    <a asp-controller="Order" asp-action="Index" class="btn btn-outline-success">Order History</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="Shop" class="card border-0 shadow-sm text-decoration-none h-100 hover-lift">
                <div class="card-body text-center py-4">
                    <i class="bi bi-shop fs-1 text-primary"></i>
                    <h6 class="mt-2 text-dark">Browse Shop</h6>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Account" asp-action="Profile" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-person-circle fs-1 text-secondary"></i>
                    <h6 class="mt-2 text-dark">My Profile</h6>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="Contact" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-envelope fs-1 text-info"></i>
                    <h6 class="mt-2 text-dark">Contact Support</h6>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="Index" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-house fs-1 text-warning"></i>
                    <h6 class="mt-2 text-dark">Store Home</h6>
                </div>
            </a>
        </div>
    </div>
</div>
